{
  "name": "zig-mcp-server",
  "version": "1.0.0",
  "description": "Zig Documentation MCP Server",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "audit:stdlib-docs": "npm run build && node build/audit-stdlib-docs.js",
    "build": "tsc && chmod 755 build/index.js",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "zig",
    "mcp",
    "documentation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@vitest/ui": "^4.0.18",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
